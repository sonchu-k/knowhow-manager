# Source documents contain identifying information; never track them
inbox/*
!inbox/.gitkeep

# Confidentiality agreements and internal regulations (confidential themselves)
policies/*
!policies/.gitkeep

# List of proper nouns to detect (identifying in itself)
.sensitive-terms.txt

# Per-user settings
knowhow.config.local.json

.DS_Store
__pycache__/
.env
.claude/settings.local.json
