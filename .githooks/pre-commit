#!/bin/sh
# Check that the commit contains no source documents, policy documents, or identifying information.
# The folders checked follow knowhow_dir / inbox_dir / policies_dir in knowhow.config.json.
# Enable with: git config core.hooksPath .githooks

python3 .claude/skills/extract-knowhow/scripts/check_sensitive.py --pre-commit
status=$?
if [ "$status" -eq 1 ]; then
    echo "Possible source material or identifying information found. Fix it and commit again." >&2
fi
exit "$status"
